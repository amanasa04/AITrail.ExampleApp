{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paycor.local/schemas/review-event.schema.json",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "progress_id",
    "criterion_id",
    "reviewer_id",
    "decision",
    "comment",
    "decided_at"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "const": "review_decision" },
    "progress_id": { "type": "string", "minLength": 1 },
    "criterion_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "needs_update"]
    },
    "comment": { "type": "string" },
    "decided_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
