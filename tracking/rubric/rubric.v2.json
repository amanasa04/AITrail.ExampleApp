{
  "rubric_id": "ai-trail",
  "name": "AI Trail Progression Rubric",
  "version": "2.0.0",
  "effective_from": "2026-06-08",
  "status": "active",
  "supersedes": "1.0.0",
  "levels": [
    {
      "level_id": "L1",
      "name": "Environment and Instruction Foundations",
      "sequence": 1,
      "criteria": [
        {
          "criterion_id": "L1-C1",
          "description": "copilot-instructions.md present and reviewed",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L1-C2",
          "description": "Workspace setup decision documented (repo vs multi-repo + rationale)",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L1-C3",
          "description": "Proof of toolkit initialization in repo history or setup notes",
          "required": true,
          "evidence_type": "checklist",
          "gate_weight": 1
        },
        {
          "criterion_id": "L1-C4",
          "description": "Conditional instruction files (if applicable) created and referenced",
          "required": false,
          "evidence_type": "document_link",
          "gate_weight": 0
        }
      ]
    },
    {
      "level_id": "L2",
      "name": "Spec-Driven Planning Practitioner",
      "sequence": 2,
      "criteria": [
        {
          "criterion_id": "L2-C1",
          "description": "Product/codebase spec artifacts exist (e.g. under .agent-os/)",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L2-C2",
          "description": "Feature specification artifacts exist for in-flight work",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L2-C3",
          "description": "Technical implementation approach documented and reviewed",
          "required": true,
          "evidence_type": "review_note",
          "gate_weight": 1
        },
        {
          "criterion_id": "L2-C4",
          "description": "Spec revisions recorded after human review feedback",
          "required": true,
          "evidence_type": "review_note",
          "gate_weight": 1
        }
      ]
    },
    {
      "level_id": "L3",
      "name": "Controlled Agent Execution",
      "sequence": 3,
      "criteria": [
        {
          "criterion_id": "L3-C1",
          "description": "Task plan file(s) with progress updates and issue notes",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L3-C2",
          "description": "Execution logs showing iterative completion and review checkpoints",
          "required": true,
          "evidence_type": "review_note",
          "gate_weight": 1
        },
        {
          "criterion_id": "L3-C3",
          "description": "AI attribution/tagging evidence where applicable",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L3-C4",
          "description": "Commits reflecting small-batch implementation and recoverability",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        }
      ]
    },
    {
      "level_id": "L4",
      "name": "Quality, Security, and Governance Operator",
      "sequence": 4,
      "criteria": [
        {
          "criterion_id": "L4-C1",
          "description": "Validation proof: successful build/test checkpoints and acceptance mapping",
          "required": true,
          "evidence_type": "checklist",
          "gate_weight": 1
        },
        {
          "criterion_id": "L4-C2",
          "description": "Security review notes for dependency additions and sensitive code paths",
          "required": true,
          "evidence_type": "review_note",
          "gate_weight": 1
        },
        {
          "criterion_id": "L4-C3",
          "description": "Evidence of code review feedback cycles and refactoring outcomes",
          "required": true,
          "evidence_type": "document_link",
          "gate_weight": 1
        },
        {
          "criterion_id": "L4-C4",
          "description": "Demonstrated adherence to policy constraints (no secrets/PII in prompts, etc.)",
          "required": true,
          "evidence_type": "checklist",
          "gate_weight": 1
        }
      ]
    }
  ]
}
