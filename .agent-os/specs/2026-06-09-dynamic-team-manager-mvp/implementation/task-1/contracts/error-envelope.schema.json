{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dynamic Team Manager API Error Envelope",
  "type": "object",
  "required": ["code", "message", "correlationId"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\.]+$",
      "examples": ["VALIDATION_FAILED", "NOT_FOUND", "AUTH_FORBIDDEN"]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100,
      "description": "Request correlation id passed from client or generated server-side."
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "issue"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "attemptedValue": {}
        }
      },
      "default": []
    }
  }
}
